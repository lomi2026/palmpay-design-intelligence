# Server-side PostgreSQL connection. Do not commit real credentials.
DATABASE_URL="postgresql://palmpay:palmpay@localhost:5432/palmpay_design_hub?schema=public"

# Future authentication adapter boundary. SSO/OIDC provider is intentionally undecided.
AUTH_MODE="development"
AUTH_AUTO_PROVISION="false"
DEFAULT_ORGANIZATION_CODE="palmpay-experience-design"
API_BASE_URL="http://localhost:3001"

# Test-environment-only session adapter. Never use in production; keep both values server-side.
TEST_AUTH_ACCESS_CODE=""
TEST_AUTH_SESSION_SECRET=""
TEST_AUTH_SESSION_TTL_SECONDS="28800"

# Local development storage. Files remain on this Mac and are never committed.
FILE_STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="/private/tmp/palmpay-design-intelligence-uploads"
LOCAL_STORAGE_SIGNING_SECRET=""
FILE_STORAGE_SIGNED_URL_TTL_SECONDS="300"

# Cloudflare R2 (S3-compatible) production option. Keep real values in apps/api/.env only.
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_BUCKET="palmpay-design-hub"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_SIGNED_URL_TTL_SECONDS="300"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
